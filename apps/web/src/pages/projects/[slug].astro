---
import { ProjectDetail } from '../../components/projects/project-detail';
import Layout from '../../layouts/Layout.astro';
import { profile } from '../../lib/about/profile';
import { localize } from '../../lib/i18n/translator';
import { getLocalizedProjects } from '../../lib/projects/collection';
import { metaDescription } from '../../lib/seo/site';
import { breadcrumbNode, projectNode } from '../../lib/seo/structured-data';

export async function getStaticPaths() {
  const projects = await getLocalizedProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const path = `/projects/${project.slug}`;
const description = metaDescription(project.summary.en);
---

<Layout
  title={localize('meta.projectTitle', {
    project: project.name,
    name: profile.name,
  })}
  description={description}
  type="article"
  structuredData={[
    projectNode(site, {
      name: project.name,
      path,
      description,
      started: project.started,
      stack: project.stack,
      links: project.links.map((link) => ({
        label: link.label.en,
        href: link.href,
      })),
    }),
    breadcrumbNode(site, [
      { name: 'Home', path: '/' },
      { name: 'Projects', path: '/projects' },
      { name: project.name, path },
    ]),
  ]}
>
  <ProjectDetail
    slug={project.slug}
    name={project.name}
    summary={project.summary}
    started={project.started}
    status={project.status}
    stack={project.stack}
    links={project.links}
    parts={project.parts}
    body={project.body}
  />
</Layout>
