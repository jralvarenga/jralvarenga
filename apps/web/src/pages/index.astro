---
import { HomePage } from '../components/home/home-page';
import Layout from '../layouts/Layout.astro';
import { getLocalizedProjectSummaries } from '../lib/projects/collection';
import { pageDescriptions } from '../lib/seo/site';

/** The home page shows the first projects by `order`; /projects lists all. */
const HOME_PROJECT_COUNT = 2;

const projects = (await getLocalizedProjectSummaries()).slice(
  0,
  HOME_PROJECT_COUNT,
);
---

<Layout description={pageDescriptions.home}>
  <HomePage projects={projects} />
</Layout>
