---
import { Font } from 'astro:assets';
import {
  BING_SITE_VERIFICATION,
  GOOGLE_SITE_VERIFICATION,
} from 'astro:env/server';
import avatar from '../assets/avatar.jpg';
import { Footer } from '../components/layout/footer';
import { FooterSettings } from '../components/layout/footer-settings';
import { Header } from '../components/layout/header';
import { profile } from '../lib/about/profile';
import { isInvariant, type Text, textIn } from '../lib/i18n/locales';
import { settingsCopy } from '../lib/i18n/settings-copy';
import { localize } from '../lib/i18n/translator';
import {
  absoluteUrl,
  DEFAULT_DESCRIPTION,
  LOCALE,
  metaDescription,
  OG_HEIGHT,
  OG_WIDTH,
  ogImagePath,
  SITE_NAME,
  THEME_COLORS,
  X_HANDLE,
} from '../lib/seo/site';
import {
  type JsonLd,
  personNode,
  serializeJsonLd,
  websiteNode,
} from '../lib/seo/structured-data';
import '../styles/global.css';
import { bodyClass } from '../styles/root';

interface Props {
  /** Tab title. Pass one string per locale; search and social use English. */
  title?: Text;
  /** Search result snippet and social preview text, ideally 70–160 chars. */
  description?: string;
  /** `og:type`. Inner pages about one thing use `article` or `profile`. */
  type?: 'website' | 'article' | 'profile';
  /** Keeps the page out of search results, such as `/ui` and the 404. */
  noindex?: boolean;
  /** Page-specific JSON-LD, appended to the `@graph` after WebSite and Person. */
  structuredData?: JsonLd[];
}

const {
  title: rawTitle = localize('meta.defaultTitle', {
    name: profile.name,
    title: localize('profile.title'),
  }),
  description: rawDescription = DEFAULT_DESCRIPTION,
  type = 'website',
  noindex = false,
  structuredData = [],
} = Astro.props;

// `site` is always set in astro.config.mjs.
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = absoluteUrl(Astro.url.pathname, site);
const image = absoluteUrl(
  noindex ? ogImagePath('/') : ogImagePath(Astro.url.pathname),
  site,
);
const title = textIn(rawTitle, 'en');
// The inline script swaps the tab title from these when the page language
// isn't English. Search engines and social cards keep the English one.
const localizedTitles = isInvariant(rawTitle)
  ? {}
  : { 'data-title-en': title, 'data-title-es': textIn(rawTitle, 'es') };
const description = metaDescription(rawDescription);
const imageAlt = title;
const jsonLd = serializeJsonLd([
  websiteNode(site),
  personNode(site, absoluteUrl(avatar.src, site)),
  ...structuredData,
]);
---

<!doctype html>
<html lang="en" {...localizedTitles}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="author" content={profile.name}>
    {noindex ? (
      <meta name="robots" content="noindex, follow">
    ) : (
      <>
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        >
        <link rel="canonical" href={canonical}>
      </>
    )}
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content={THEME_COLORS.light}
    >
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content={THEME_COLORS.dark}
    >
    <link rel="sitemap" href="/sitemap-index.xml">
    <link
      rel="describedby"
      type="text/plain"
      href="/llms.txt"
      title="LLM information"
    >
    <meta name="generator" content={Astro.generator}>
    {GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION}>
    )}
    {BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={BING_SITE_VERIFICATION}>
    )}
    <meta property="og:site_name" content={SITE_NAME}>
    <meta property="og:locale" content={LOCALE}>
    <meta property="og:type" content={type}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={image}>
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content={String(OG_WIDTH)}>
    <meta property="og:image:height" content={String(OG_HEIGHT)}>
    <meta property="og:image:alt" content={imageAlt}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content={X_HANDLE}>
    <meta name="twitter:creator" content={X_HANDLE}>
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={image}>
    <meta name="twitter:image:alt" content={imageAlt}>
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <script is:inline>
    // Apply the language before paint: the stored choice, else the first of
    // the browser's languages the site has, else English. Keys and codes
    // match lib/i18n/locale.ts and lib/i18n/locales.ts. Translation hides
    // the copy that doesn't match `<html lang>`.
    try {
      let locale = null;
      try {
        locale = localStorage.getItem('locale');
      } catch {}
      if (locale !== 'en' && locale !== 'es') {
        locale = 'en';
        for (const language of navigator.languages ?? [navigator.language]) {
          const code = language.toLowerCase().split('-')[0];
          if (code === 'en' || code === 'es') {
            locale = code;
            break;
          }
        }
      }
      const root = document.documentElement;
      root.lang = locale;
      const localizedTitle = root.getAttribute(`data-title-${locale}`);
      if (localizedTitle) document.title = localizedTitle;
    } catch {}
    </script>
    <script is:inline>
    // Apply the stored theme before paint. The key matches lib/theme.ts.
    try {
      const theme = localStorage.getItem('theme');
      if (theme === 'light' || theme === 'dark') {
        document.documentElement.dataset.theme = theme;
        // Media-query theme-color tags follow the OS. A tag without
        // `media` overrides them so the browser chrome matches the page.
        const media = document.querySelector(
          `meta[name="theme-color"][media*="${theme}"]`,
        );
        if (media) {
          let meta = document.querySelector(
            'meta[name="theme-color"]:not([media])',
          );
          if (!meta) {
            meta = document.createElement('meta');
            meta.setAttribute('name', 'theme-color');
            media.before(meta);
          }
          meta.setAttribute('content', media.getAttribute('content') ?? '');
        }
      }
    } catch {}
    </script>
    <Font cssVariable="--font-geist-sans" preload />
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-geist-pixel" preload />
    {import.meta.env.DEV && (
      <>
        <link rel="stylesheet" href="/virtual:stylex.css">
        <script type="module" src="/@id/virtual:stylex:runtime"></script>
      </>
    )}
  </head>
  <body class={bodyClass}>
    <Header pathname={Astro.url.pathname} />
    <slot />
    <Footer>
      <FooterSettings slot="settings" copy={settingsCopy()} client:visible />
    </Footer>
    <script>
    import { currentLocale, localizeAttributes } from '../lib/i18n/locale';
    import { revealPixels } from '../lib/pixel-reveal';
    import { bindThemeHotkey } from '../lib/theme';

    bindThemeHotkey();
    // Attributes such as `aria-label` follow the language set in `<head>`.
    localizeAttributes(currentLocale());

    // The hero name and every page title build themselves out of pixels.
    for (const element of document.querySelectorAll<HTMLElement>(
      '[data-pixel-reveal]',
    )) {
      void revealPixels(element);
    }
    </script>
  </body>
</html>
