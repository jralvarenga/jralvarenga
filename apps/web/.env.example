# Optional. Avoids GitHub API rate-limit failures in the skills content loader.
# Copy this file to .env, or set the variable in your shell. GH_TOKEN also works.
# A fine-grained token with read-only access to public repositories is enough.
# GITHUB_TOKEN=

# Optional. Production origin for canonical URLs, Open Graph tags, the
# sitemap, and robots.txt. Defaults to https://jralvarenga.com. Loaded
# from this file by Vite's loadEnv in astro.config.mjs.
# SITE_URL=https://jralvarenga.com

# Optional. Search engine ownership tokens, rendered as <meta> tags on every
# page. Paste only the `content` value of the tag each console gives you.
# Google Search Console: HTML tag method, <meta name="google-site-verification">.
# GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: HTML meta tag method, <meta name="msvalidate.01">.
# BING_SITE_VERIFICATION=
